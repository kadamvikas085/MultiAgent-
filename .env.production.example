# Copy to .env.production and fill in real values.
# NEVER commit the filled-in file — .gitignore already excludes .env.*
# (see docker-compose.prod.yml, which reads this via env_file).

APP_ENV=production
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Postgres (used to build DATABASE_URL in docker-compose.prod.yml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Redis (used to build REDIS_URL / CELERY_* URLs in docker-compose.prod.yml)
REDIS_PASSWORD=

# Neo4j
NEO4J_USER=
NEO4J_PASSWORD=

# LLM
# Keep USE_MOCK_LLM=true for a prototype deployment that shouldn't burn real
# API RPD; set to false + provide OPENAI_API_KEY once you're ready for real
# inference in production.
USE_MOCK_LLM=true
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# CORS — set to your real deployed frontend origin(s), comma-separated.
ALLOWED_ORIGINS=https://your-frontend-domain.example

# Storage
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=100
