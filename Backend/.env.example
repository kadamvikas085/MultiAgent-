# App
# APP_ENV controls dev-only behavior (currently: /docs and /redoc are only
# served when APP_ENV=development — see Backend/app/main.py).
APP_NAME=UniHack AI
APP_ENV=development
DEBUG=true
# SECRET_KEY: use a long random value in any shared/deployed environment.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Postgres
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=product_embeddings

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=username
NEO4J_PASSWORD=change-me

# LLM Providers
# USE_MOCK_LLM=true (default): the whole pipeline runs offline via
# MockLLMService — no OPENAI_API_KEY needed, zero external API requests/RPD
# consumed. Set to false + provide OPENAI_API_KEY to use the real API.
# See app/services/llm_service.py:get_llm_service().
USE_MOCK_LLM=true
OPENAI_API_KEY=
LLM_MODEL=gpt-4.1
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Storage
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=100

# --- Production ---
# This file documents local development defaults. For a production or
# public-prototype deployment, use .env.production.example as the starting
# point instead (APP_ENV=production, DEBUG=false, strong SECRET_KEY,
# managed/private DATABASE_URL, REDIS_URL, QDRANT_URL, NEO4J_URI, and a real
# ALLOWED_ORIGINS list) together with docker-compose.prod.yml.

